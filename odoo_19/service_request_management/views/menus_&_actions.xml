<?xml version="1.0" encoding="utf-8"?>

<odoo>


    <record id="action_service_request" model="ir.actions.act_window">
        <field name="name">action_service_request</field>
        <field name="res_model">service.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record
            </p>
        </field>
    </record>
    <record id="action_service_request_line" model="ir.actions.act_window">
        <field name="name">action_service_request_line</field>
        <field name="res_model">service.request.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record
            </p>
        </field>
    </record>

    <record id="action_service_request_tag" model="ir.actions.act_window">
        <field name="name">action_service_request</field>
        <field name="res_model">service.request.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record
            </p>
        </field>
    </record>

    <record id="action_service_request_wizard" model="ir.actions.act_window">
        <field name="name">action_service_request_wizard</field>
        <field name="res_model">service.request.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem
            id="service_request_menu_root"
            name="service request"
    />

    <menuitem
            id="menu_service_request"
            name="service request"
            parent="service_request_menu_root"
            action="action_service_request"
            sequence="10"/>

    <menuitem
            id="menu_service_request_line"
            name="service request line"
            parent="service_request_menu_root"
            action="action_service_request_line"
            sequence="20"/>

    <menuitem
            id="menu_service_request_tag"
            name="service request tag"
            parent="service_request_menu_root"
            action="action_service_request_tag"
            sequence="30"/>

    <menuitem
            id="menu_service_request_report"
            name="service request report"
            parent="service_request_menu_root"
            action="action_service_request_wizard"
            sequence="30"/>


</odoo>



