<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="service_request_view_list" model="ir.ui.view">
        <field name="name">service.request.list</field>
        <field name="model">service.request</field>
        <field name="arch" type="xml">
            <list string="Service Requests">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="request_date"/>
                <field name="priority" widget="badge"
                       decoration-warning="priority == 'normal'"
                       decoration-danger="priority == 'high'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"
                       decoration-muted="state in ('draft', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="service_request_view_form" model="ir.ui.view">
        <field name="name">service.request.form</field>
        <field name="model">service.request</field>
        <field name="arch" type="xml">
            <form string="Service Request">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="Request title"/></h1>
                        <h2><field name="name"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="request_date"/>
                        </group>
                        <group>
                            <field name="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe the issue..."/>
                        </page>
                        <page string="Attachment">
                            <field name="attachment" filename="attachment_filename"/>
                            <field name="attachment_filename" invisible="True"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="service_request_action" model="ir.actions.act_window">
        <field name="name">Service Requests</field>
        <field name="res_model">service.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first service request</p>
        </field>
    </record>

    <menuitem id="service_request_menu_root" name="Service Requests"
              sequence="35" groups="base.group_user"/>
    <menuitem id="service_request_menu" name="Requests"
              parent="service_request_menu_root" action="service_request_action"
              sequence="10" groups="base.group_user"/>
</odoo>
